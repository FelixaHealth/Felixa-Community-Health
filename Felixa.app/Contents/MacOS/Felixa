#!/bin/bash
# Felixa Community Health: starts the app in the background and opens it in your browser. No Terminal window.
# Opening it again while the app runs just opens the browser. "Stop Felixa" stops it.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
STATE="$HOME/Library/Application Support/Felixa"
LOGDIR="$HOME/Library/Logs/Felixa"
LOG="$LOGDIR/felixa.log"
# Everything the app writes (its Python environment, your workplaces and messages) lives here, not in the downloaded folder: macOS opens a
# freshly downloaded app from a read-only copy, where nothing can be written.
VENV="$STATE/venv"
export FELIXA_DATA_DIR="$STATE/data"
export PYTHONDONTWRITEBYTECODE=1
mkdir -p "$STATE" "$LOGDIR"
# A program started by double-click gets a short PATH: add where Claude Code, Homebrew and python.org put things.
PY_BINS=""
for d in /Library/Frameworks/Python.framework/Versions/*/bin; do [ -d "$d" ] && PY_BINS="$d:$PY_BINS"; done
export PATH="$HOME/.local/bin:$PY_BINS/opt/homebrew/bin:/usr/local/bin:$PATH"

browse() { [ -n "$FELIXA_NO_BROWSER" ] || open "$1"; }      # "Felixa Always On" starts the app at login without opening a window
notify() { command -v osascript >/dev/null 2>&1 && osascript -e "display notification \"$1\" with title \"Felixa\"" >/dev/null 2>&1; echo "$(date '+%F %T') $1" >>"$LOG"; }
stop_with() {
  echo "$(date '+%F %T') STOPPED: $1" >>"$LOG"
  LAST="$(tail -n 4 "$LOG" 2>/dev/null | tr -d '"\\' | cut -c1-160 | tr '\n' ' ')"
  command -v osascript >/dev/null 2>&1 && osascript -e "display dialog \"$1\" & return & return & \"$LAST\" & return & return & \"Details: $LOG\" buttons {\"OK\"} default button 1 with icon caution with title \"Felixa\"" >/dev/null 2>&1
  exit 1
}

# Run from a private copy. A freshly downloaded app is opened by macOS from a locked, temporary location (AppTranslocation) that Python cannot read, and
# a folder that is moved or deleted would take the app with it. So the first time, Felixa copies itself into its own folder and runs from there; the update
# below keeps that copy current. The folder you downloaded is only used to get started.
APP_HOME="$STATE/app"
BOOT_ZIP="${FELIXA_UPDATE_ZIP:-https://github.com/FelixaHealth/Felixa-Community-Health/archive/refs/heads/main.zip}"
if [ -z "$FELIXA_BOOTSTRAPPED" ] && [ "$ROOT" != "$APP_HOME" ]; then
  if [ ! -f "$APP_HOME/.installed" ]; then
    notify "Installing Felixa. This takes a moment."
    mkdir -p "$APP_HOME"
    if ! cp -R "$ROOT/." "$APP_HOME/" 2>>"$LOG" || [ ! -f "$APP_HOME/app.py" ]; then
      TMPB="$(mktemp -d)"
      if curl -fsSL --max-time 180 -o "$TMPB/z.zip" "$BOOT_ZIP" 2>>"$LOG" && unzip -q -o "$TMPB/z.zip" -d "$TMPB/n" 2>>"$LOG"; then
        cp -R "$(ls -d "$TMPB"/n/*/ | head -n 1)." "$APP_HOME/" 2>>"$LOG"
      fi
      rm -rf "$TMPB"
    fi
    [ -f "$APP_HOME/app.py" ] || stop_with "Could not install Felixa. Check your internet connection and open Felixa again."
    xattr -dr com.apple.quarantine "$APP_HOME" 2>/dev/null
    chmod +x "$APP_HOME"/*.app/Contents/MacOS/* 2>/dev/null
    touch "$APP_HOME/.installed"
  fi
  export FELIXA_BOOTSTRAPPED=1
  exec "$APP_HOME/Felixa.app/Contents/MacOS/Felixa"
fi
[ -n "$FELIXA_PREPARE_ONLY" ] && exit 0

# Update: every time Felixa is opened it checks GitHub for a newer version of itself and, if there is one, installs it (your workplaces and messages are kept
# elsewhere and are not touched), restarts the app if it was running, and carries on. No internet or no change: nothing happens.
UPDATE_API="${FELIXA_UPDATE_API:-https://api.github.com/repos/FelixaHealth/Felixa-Community-Health/commits/main}"
UPDATE_ZIP="${FELIXA_UPDATE_ZIP:-https://github.com/FelixaHealth/Felixa-Community-Health/archive/refs/heads/main.zip}"
if [ -z "$FELIXA_NO_UPDATE" ] && [ -z "$FELIXA_UPDATED" ] && [ -w "$ROOT" ]; then
  REMOTE="$(curl -fsS --max-time 8 -H 'Accept: application/vnd.github.sha' "$UPDATE_API" 2>/dev/null | tr -dc 'a-f0-9')"
  if [ ${#REMOTE} -ge 7 ] && [ "$REMOTE" != "$(cat "$STATE/version" 2>/dev/null)" ]; then
    TMP="$(mktemp -d 2>/dev/null)"
    if [ -n "$TMP" ] && curl -fsSL --max-time 120 -o "$TMP/new.zip" "$UPDATE_ZIP" 2>>"$LOG" && unzip -q -o "$TMP/new.zip" -d "$TMP/new" 2>>"$LOG"; then
      SRC="$(ls -d "$TMP"/new/*/ 2>/dev/null | head -n 1)"
      if [ -n "$SRC" ] && [ -f "${SRC}app.py" ] && cp -R "${SRC}." "$ROOT/" 2>>"$LOG"; then
        chmod +x "$ROOT"/*.app/Contents/MacOS/* 2>/dev/null
        echo "$REMOTE" >"$STATE/version"
        echo "$(date '+%F %T') updated to $REMOTE" >>"$LOG"
        if [ -f "$STATE/pid" ]; then kill "$(cat "$STATE/pid")" 2>/dev/null; sleep 1; rm -f "$STATE/pid" "$STATE/port"; fi
        rm -rf "$TMP"
        notify "Felixa is up to date."
        export FELIXA_UPDATED=1
        exec "$ROOT/Felixa.app/Contents/MacOS/Felixa"
      fi
    fi
    [ -n "$TMP" ] && rm -rf "$TMP"
    echo "$(date '+%F %T') could not update; using the version already here" >>"$LOG"
  fi
fi

# Phone mode ("Felixa on Phone"): share the app with phones on the same Wi-Fi. It restarts the app if it runs for this Mac only.
if [ -n "$FELIXA_SHARE" ]; then
  if [ -f "$STATE/pid" ]; then kill "$(cat "$STATE/pid")" 2>/dev/null; sleep 1; rm -f "$STATE/pid" "$STATE/port"; fi
  LAN_IP="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || hostname -I 2>/dev/null | cut -d' ' -f1)"
  [ -n "$LAN_IP" ] || stop_with "This Mac is not on a Wi-Fi or network, so a phone cannot reach it. Connect to your home Wi-Fi and open Felixa on Phone again."
  LOCAL_NAME="$(scutil --get LocalHostName 2>/dev/null)"
  export FELIXA_HOST=0.0.0.0
  export FELIXA_ALLOWED_HOSTS="$LAN_IP${LOCAL_NAME:+,$LOCAL_NAME.local}"
fi

# Already running: open the browser and finish. (A private open after sharing restarts it for this Mac only.)
if [ -z "$FELIXA_SHARE" ] && [ -f "$STATE/shared" ] && [ -f "$STATE/pid" ]; then kill "$(cat "$STATE/pid")" 2>/dev/null; sleep 1; rm -f "$STATE/pid" "$STATE/port" "$STATE/shared"; fi
if [ -f "$STATE/port" ] && curl -fs "http://127.0.0.1:$(cat "$STATE/port")/health" >/dev/null 2>&1; then
  browse "http://127.0.0.1:$(cat "$STATE/port")"
  exit 0
fi

cd "$ROOT" || stop_with "The Felixa folder was not found. Keep Felixa.app inside the Felixa-Community-Health folder."

# Python 3.10 or newer.
PY=""
for candidate in python3.15 python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then PY="$candidate"; break; fi
done
[ -n "$PY" ] || stop_with "Python 3.10 or newer is needed. Install it from python.org, then open Felixa again."

# First time (or after an update): set the app up. The browser opens when it is ready.
WANT="$(shasum requirements.txt 2>/dev/null | cut -d' ' -f1)"
if [ ! -x "$VENV/bin/python" ] || [ "$(cat "$STATE/requirements.sha" 2>/dev/null)" != "$WANT" ]; then
  notify "Setting Felixa up for the first time. This takes a few minutes. Your browser opens when it is ready."
  if [ -d "$VENV" ] && ! "$VENV/bin/python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then rm -rf "$VENV"; fi
  [ -x "$VENV/bin/python" ] || "$PY" -m venv "$VENV" >>"$LOG" 2>&1 || stop_with "Could not create the Python environment."
  "$VENV/bin/python" -m pip install -q -r requirements.txt >>"$LOG" 2>&1 || stop_with "Could not install what Felixa needs. Check your internet connection and open Felixa again."
  echo "$WANT" >"$STATE/requirements.sha"
fi

command -v claude >/dev/null 2>&1 || notify "Claude Code was not found, so Your Claude login will not work. Install it from claude.com/claude-code and sign in once."

if [ -f ".env" ]; then set -a; . ./.env; set +a; fi
export FELIXA_NO_LOCAL_MODEL=1
unset ANTHROPIC_API_KEY FELIXA_ANTHROPIC_API_KEY
PORT="$("$VENV/bin/python" pick_port.py 2>>"$LOG")" || stop_with "No free port was found."
export PORT
nohup "$VENV/bin/python" app.py >>"$LOG" 2>&1 &
echo $! >"$STATE/pid"
echo "$PORT" >"$STATE/port"
if [ -n "$FELIXA_SHARE" ]; then touch "$STATE/shared"; else rm -f "$STATE/shared"; fi

for _ in $(seq 1 120); do
  if curl -fs "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
    browse "http://127.0.0.1:$PORT"
    if [ -n "$FELIXA_SHARE" ]; then
      URL="http://$LAN_IP:$PORT"
      echo "$(date '+%F %T') shared at $URL" >>"$LOG"
      ANSWER="$(osascript -e "display dialog \"On your phone, connected to the same Wi-Fi as this Mac, open this address:\" & return & return & \"$URL\" & return & return & \"Anyone on this Wi-Fi can open it while Felixa is shared, so use it only on a network you trust. Open Felixa (without Phone) any time to stop sharing.\" buttons {\"Copy address\", \"OK\"} default button \"OK\" with title \"Felixa on Phone\"" 2>/dev/null)"
      case "$ANSWER" in *"Copy address"*) printf '%s' "$URL" | pbcopy ;; esac
    fi
    exit 0
  fi
  kill -0 "$(cat "$STATE/pid")" 2>/dev/null || stop_with "Felixa stopped while starting."
  sleep 0.5
done
stop_with "Felixa did not start in time."

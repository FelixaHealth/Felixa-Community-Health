# Copy this file to .env. A line that begins with # is a comment. On any other line, run_windows.bat takes everything after the first = as the value,
# so write a comment on a line of its own, never after a value, or it becomes part of the value.
# Felixa BEI runs on a local Ollama model. No cloud API key is needed.
# Local runs default to qwen2.5:7b, and run_mac.command and run_windows.bat download the model named here unless exactly that model is installed. The hosted launcher, start_online.py, downloads qwen2.5:3b and runs the app on it unless FELIXA_LOCAL_MODEL is set.
FELIXA_LOCAL_MODEL=qwen2.5:7b
FELIXA_OLLAMA_URL=http://127.0.0.1:11434
PORT=5000

# Optional: take the # off a setting to use it, and give it a value if it has none.
# 127.0.0.1 keeps a local run private. The hosted deploy listens on 0.0.0.0 itself. With a password, other computers can sign in only over https (see README, Hosting).
# FELIXA_HOST=127.0.0.1
# Set it to require sign-in (always set it when hosted; the hosted launcher refuses fewer than 12 characters). The sign-in cookie is Secure: a browser keeps it only over https or at http://127.0.0.1
# FELIXA_PASSWORD=
# FELIXA_USERNAME=felixa
# Extra host names (no port, comma separated) a run without a password answers to, e.g. a LAN address. 127.0.0.1, localhost and [::1] always work.
# FELIXA_ALLOWED_HOSTS=
# Where felixa.db lives (default: the app folder).
# FELIXA_DATA_DIR=
# Communication units stored per analysis (one file or paste is read up to 50,000 messages, a PDF up to 100 pages); the page says when an import had more.
# FELIXA_MAX_UNITS=5000
# Units sent through the 13-signal rating; larger uploads are sampled evenly.
# FELIXA_MAX_RATED_UNITS=300
# CPU threads for the model. Leave it commented out to let Ollama choose.
# FELIXA_NUM_THREAD=
# Seconds to wait for one model answer.
# FELIXA_MODEL_TIMEOUT=480
# One line printed on the PDF cover.
# FELIXA_REPORT_CONTACT=

# Claude as a cloud engine, free for people testing the app (the server's key pays). Leave it out and the Claude engines show as off.
# FELIXA_ANTHROPIC_API_KEY=sk-ant-...
# The OpenAI API engines (GPT-4o mini, GPT-4o) switch on with this key:
# FELIXA_OPENAI_API_KEY=sk-...
# Claude through the person's own Claude Code login (no key). On by default on a computer where `claude` is installed, and off for any app with a password. 0 switches it off.
# FELIXA_CLAUDE_LOGIN=0
# Hosted without a model of its own (needs FELIXA_ANTHROPIC_API_KEY): only the web app starts and Claude is the only engine. See DEPLOY.md.
# FELIXA_NO_LOCAL_MODEL=1
